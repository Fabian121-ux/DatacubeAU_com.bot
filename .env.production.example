# Copy to .env.production and replace every placeholder before deployment.
# Compose reads this file for interpolation; it is NOT mounted wholesale into any service.

APP_NAME=Zina AU WhatsApp Bot
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
ADMIN_API_TOKEN=replace-with-a-long-random-admin-api-token
ADMIN_USERNAME=zina
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_COOKIE_SECURE=true
STARTUP_VALIDATE_DB=true

# PostgreSQL bootstrap/migration-owner account. The official Postgres image
# creates POSTGRES_USER as its database bootstrap superuser.
POSTGRES_USER=datacube
POSTGRES_PASSWORD=replace-with-a-long-migration-owner-password
POSTGRES_DB=datacube_bot
DATABASE_URL=postgresql+asyncpg://datacube:replace-with-url-encoded-migration-owner-password@postgres:5432/datacube_bot
DATABASE_URL_SYNC=postgresql://datacube:replace-with-url-encoded-migration-owner-password@postgres:5432/datacube_bot

# Separate non-owner API login. URL-encode reserved characters in the URL,
# but keep ZINA_RUNTIME_DB_PASSWORD as the raw password.
DATABASE_URL_RUNTIME=postgresql+asyncpg://zina_runtime:replace-with-url-encoded-runtime-password@postgres:5432/datacube_bot
ZINA_RUNTIME_DB_PASSWORD=replace-with-raw-runtime-password
ZINA_RUNTIME_DB_ROLE=zina_runtime
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

WAHA_IMAGE=devlikeapro/waha:latest
WAHA_API_KEY=replace-with-a-long-random-waha-api-key
WAHA_SERVICE_URL=http://waha:3000
WAHA_BASE_URL=http://YOUR_SERVER_IP:3000
WAHA_SESSION_NAME=default
WAHA_SEND_PATH=/api/sendText
WAHA_SEND_IMAGE_PATH=/api/sendImage
WAHA_SESSION_STATUS_PATH=/api/sessions
WAHA_CHATS_PATH=/api/{session}/chats
WAHA_REQUEST_TIMEOUT_SECONDS=15
WAHA_REQUEST_RETRY_COUNT=2
WAHA_REQUEST_RETRY_BACKOFF_SECONDS=1.0
WHATSAPP_HOOK_URL=http://api:8080/webhooks/waha-events
WHATSAPP_HOOK_EVENTS=message,message.any,message.revoked
WHATSAPP_HOOK_RETRIES_POLICY=linear
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
WHATSAPP_HOOK_RETRIES_ATTEMPTS=6
WAHA_AUTO_START_DELAY_SECONDS=5
WHATSAPP_RESTART_ALL_SESSIONS=true
WAHA_DASHBOARD_USERNAME=replace-with-waha-dashboard-user
WAHA_DASHBOARD_PASSWORD=replace-with-waha-dashboard-password
WHATSAPP_SWAGGER_USERNAME=replace-with-waha-swagger-user
WHATSAPP_SWAGGER_PASSWORD=replace-with-waha-swagger-password
WAHA_CONTAINER_DATA_PATH=/app/.sessions
WHATSAPP_FILES_FOLDER=/app/.media

BOT_WA_NUMBER=234000000001@c.us
OWNER_WHATSAPP_IDS=
BOT_MENTION_ALIASES=datacube bot,datacubeau
ENABLE_AUTO_REPLY=true
GROUP_DEFAULT_REPLY_MODE=mention_only
GROUP_DEFAULT_COOLDOWN_SECONDS=45
DM_DEFAULT_COOLDOWN_SECONDS=6
KB_MAX_CHUNKS=3
KB_MIN_SCORE=0.34
KB_REPLY_MAX_CHARS=420
RECENT_ITEMS_LIMIT=50

AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_LIGHT=openai/gpt-4o-mini
OPENROUTER_MODEL_DEEP=openai/gpt-4o
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_RETRY_COUNT=2
OPENROUTER_MAX_TOKENS=600

SEARXNG_URL=http://localhost:8081
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=
YOUTUBE_API_KEY=
GIPHY_API_KEY=
INTERNET_ENABLED=false
WEB_SEARCH_ENABLED=false
NEWS_ENABLED=false
WEATHER_ENABLED=false
CURRENCY_ENABLED=false
YOUTUBE_ENABLED=false
IMAGE_SEARCH_ENABLED=false
STICKER_SEARCH_ENABLED=false
INTERNET_PROVIDER=searxng
INTERNET_DAILY_LIMIT_PER_USER=25
INTERNET_CACHE_TTL_SECONDS=900
INTERNET_SMART_DETECTION_ENABLED=true

TYPING_DELAY_ENABLED=true
MIN_TYPING_DELAY_SECONDS=1.0
MAX_TYPING_DELAY_SECONDS=6.0
SHOW_SOURCE_BADGES=false
SHOW_CONTEXT_BADGES=true
ENABLE_SIGNATURE_STYLE=true
WHATSAPP_MESSAGE_FORMAT=automatic

LOCAL_TEST_DM_WHATSAPP_ID=234000000000@c.us
LOCAL_TEST_GROUP_CHAT_ID=120363000000000000@g.us
POSTGRES_PORT=5432
WAHA_HTTP_PORT=3000
PUBLIC_HTTP_PORT=80
RUN_LOCAL_SEEDS=false
ALLOW_LOCAL_SEEDS_IN_DEPLOY=false
